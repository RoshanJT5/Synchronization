{
  "manifest_version": 3,
  "name": "Synchronization",
  "version": "1.0",
  "description": "Sync browser or phone audio to nearby mobile devices.",
  "icons": {
    "16": "app_icon.jpg",
    "48": "app_icon.jpg",
    "128": "app_icon.jpg"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "offscreen",
    "geolocation"
  ],
  "host_permissions": [
    "https://sync.synchronizationpro.app/*",
    "wss://sync.synchronizationpro.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://sync.synchronizationpro.app wss://sync.synchronizationpro.app;"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Synchronization"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
